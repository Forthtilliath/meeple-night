# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands on a single guild (instant) instead of globally
DISCORD_GUILD_ID=

# SQLite file path
DATABASE_PATH=./data/bot.db
# Default IANA timezone used to interpret dates typed in commands (each server can override it
# with /settings timezone)
TIMEZONE=Europe/Paris

# Daily database copies, next to the database by default (BACKUP_KEEP=0 disables them)
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=7

# Optional /health endpoint for the host's health checks (disabled when unset)
# HEALTH_PORT=8080

# Optional direct message reminding to renew a free hosting plan (disabled when unset):
# your Discord user id, the days a renewal lasts, the panel link and the message language (en/fr)
# RENEWAL_USER_ID=
# RENEWAL_DAYS=4
# RENEWAL_URL=https://panel.example.com
# RENEWAL_LOCALE=fr
